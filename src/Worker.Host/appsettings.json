{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "WorkerPlatform": {
    "EnvironmentName": "Development",
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "SecurityProtocol": "PLAINTEXT"
    },
    "Database": {
      "ConnectionPoolSize": 25,
      "DefaultConnectionString": "Server=localhost;Database=WorkerDb;Trusted_Connection=True;TrustServerCertificate=True;",
      "UseIntegratedSecurity": true
    }
  }
}